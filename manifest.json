{
  "manifest_version": 3,
  "name": "Video Translator Remote",
  "version": "1.1.0",
  "description": "Translate and dub a video with models on your own B70 server: Qwen3-ASR transcribes, Qwen3.6 translates, Qwen3-TTS dubs in the original speaker's voice, and ffmpeg builds the new video.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "sidePanel",
    "clipboardWrite",
    "downloads",
    "windows"
  ],
  "host_permissions": [
    "https://api.github.com/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "Video Translator Remote"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}